{
  "name": "raceos-dashboard",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node scripts/verify-browser.mjs",
    "format": "prettier --write src tests scripts *.json *.ts",
    "test:smoke": "node scripts/smoke-browser.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "playwright": "^1.56.0",
    "prettier": "3.6.2"
  }
}
